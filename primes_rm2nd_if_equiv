# Removes the 2nd command-line specified primes file, if it is
# equivalent to the 1st command-line specified primes file.
# If they are equivalent is determined through the use of
# "primes_cmp -i".  Where the -i specifies that the a difference
# in the format of the two primes files is ignored.

primes_cmp -i $1 $2 && rm $2 && echo $2 removed
